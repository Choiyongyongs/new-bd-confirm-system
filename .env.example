# ----------------------------------------------------
# 1. Supabase Configuration (GitHub Pages & Vite)
# ----------------------------------------------------
# Supabase 대시보드 (Project Settings > API)에서 확인 가능한 URL 및 Anon Public Key
# GitHub Pages 호스팅 시:
#  - 방법 1: GitHub 레포지토리 Settings > Secrets and variables > Actions에 등록
#  - 방법 2: 사이트 접속 후 상단 헤더의 [Supabase 연동] 버튼을 눌러 브라우저에서 직접 입력
#  - 방법 3: 로컬 빌드 전 .env 파일에 아래 값을 입력 후 `npm run build`
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ----------------------------------------------------
# 2. Legacy Server Settings (기존 로컬 PC / 백업 서버 구동 시)
# ----------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-public-key"
PORT=3000
